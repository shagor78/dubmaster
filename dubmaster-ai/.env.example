# DubMaster AI Configuration
# Windows Environment Settings

# Gemini AI API Key for Neural Translation, Speech Recognition, and Multilingual Dubbing
GEMINI_API_KEY=your_gemini_api_key_here

# FFmpeg Executable Paths (Optional: will use PATH if not specified)
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe

# Application Workspace Directory
DUBMASTER_WORKSPACE=C:\Users\User\Documents\DubMasterAI

# Processing Defaults
DEFAULT_SOURCE_LANGUAGE=English
DEFAULT_TARGET_LANGUAGE=Bengali
DEFAULT_VOICE=Kore
DEFAULT_AUDIO_MODE=replace
